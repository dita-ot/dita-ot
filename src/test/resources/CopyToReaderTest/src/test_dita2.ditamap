<map xmlns:ditaarch="http://dita.oasis-open.org/architecture/2005/" class="- map/map "
 specializations="@props/audience                            @props/deliveryTarget                            @props/otherprops                            @props/platform                            @props/product   "
 ditaarch:DITAArchVersion="2.0">
  <topicref class="- map/topicref " href="none.dita"/>
  <topicref class="- map/topicref " href="topic.dita">
    <topicmeta class="- map/topicmeta ">
      <resourceid class="- topic/resourceid " appid="direct" appid-role="deliverable-anchor"/>
    </topicmeta>
  </topicref>
  <topicref class="- map/topicref " href="topic.dita">
    <topicmeta class="- map/topicmeta ">
    <resourceid class="- topic/resourceid " appid="keyref" appid-role="deliverable-anchor"/>
  </topicmeta>
  </topicref>
  <topicref class="- map/topicref " href="a.dita">
    <topicmeta class="- map/topicmeta ">
      <resourceid class="- topic/resourceid " appid="b" appid-role="deliverable-anchor"/>
    </topicmeta>
  </topicref>
  <topicref class="- map/topicref " href="chunk.dita" chunk="to-content">
    <topicmeta class="- map/topicmeta ">
      <resourceid class="- topic/resourceid " appid="chunk-target" appid-role="deliverable-anchor"/>
    </topicmeta>
    <topicref class="- map/topicref " copy-to="skip-b.dita" href="skip-a.dita">
      <topicmeta class="- map/topicmeta ">
        <resourceid class="- topic/resourceid " appid="skip-b" appid-role="deliverable-anchor"/>
      </topicmeta>
    </topicref>
  </topicref>
</map>
