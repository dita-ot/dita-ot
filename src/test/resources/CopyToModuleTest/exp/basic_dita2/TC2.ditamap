<?xml version="1.0" encoding="UTF-8"?>
<map xmlns:ditaarch="http://dita.oasis-open.org/architecture/2005/"
  class="- map/map "
  specializations="@props/audience                            @props/deliveryTarget                            @props/otherprops                            @props/platform                            @props/product   "
  ditaarch:DITAArchVersion="2.0">
  <topicgroup class="+ map/topicref mapgroup-d/topicgroup "
    collection-type="family">
    <topicref class="- map/topicref " href="test2.dita"
      impose-role="keeptarget">
      <topicmeta class="- map/topicmeta ">
        <resourceid class="- topic/resourceid " appid="newtest2"
          appid-role="deliverable-anchor"/>
      </topicmeta>
    </topicref>
    <topicref class="- map/topicref " href="test2.dita"
      impose-role="keeptarget">
      <topicmeta class="- map/topicmeta ">
        <resourceid class="- topic/resourceid " appid="newtest2"
          appid-role="deliverable-anchor"/>
      </topicmeta>
    </topicref>
  </topicgroup>

  <topicgroup class="+ map/topicref mapgroup-d/topicgroup "
    collection-type="family">
    <topicref class="- map/topicref " copy-to="newtest3.dita"
      href="test3.dita" impose-role="keeptarget">
      <topicmeta class="- map/topicmeta ">
        <linktitle
          class="+ topic/titlealt alternativeTitles-d/linktitle "
          title-role="linking"> newtest3_1 </linktitle>
        <shortdesc class="- map/shortdesc "> newtest3_1 </shortdesc>
      </topicmeta>
    </topicref>
    <topicref class="- map/topicref " copy-to="newtest3.dita"
      href="test3.dita" impose-role="keeptarget">
      <topicmeta class="- map/topicmeta ">
        <linktitle
          class="+ topic/titlealt alternativeTitles-d/linktitle "
          title-role="linking"> newtest3_2 </linktitle>
        <shortdesc class="- map/shortdesc "> newtest3_2 </shortdesc>
      </topicmeta>
    </topicref>
    <topicref class="- map/topicref " copy-to="newtest3.dita"
      href="test3.dita" impose-role="keeptarget">
      <topicmeta class="- map/topicmeta ">
        <linktitle
          class="+ topic/titlealt alternativeTitles-d/linktitle "
          title-role="linking"> newtest3_1 </linktitle>
        <shortdesc class="- map/shortdesc "> newtest3_1 </shortdesc>
      </topicmeta>
    </topicref>
  </topicgroup>
</map>
